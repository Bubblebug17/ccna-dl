# Copia este archivo como .env y completa los valores:
#   Copy-Item .env.example .env
# El archivo .env NO se sube a git (esta en .gitignore). Nunca compartas tu contrasena.

# Contrasena de tu cuenta de Netacad. Si la dejas vacia, el programa te la pide por consola.
PASSWORD=

# Opcional: production (por defecto) | development | test
# NODE_ENV=production